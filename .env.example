# Optional: IP address or CIDR of the reverse proxy that connects directly to
# Kaya. Leave this at 127.0.0.1 when using Kaya directly on your LAN.
# Example Docker network: FORWARDED_ALLOW_IPS=172.20.0.0/16
# Example NetBird proxy:  FORWARDED_ALLOW_IPS=100.64.0.0/10
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional host directory containing a private first-install PostgreSQL
# password file named postgres_password. The file is copied into Kaya's
# persistent Docker secret volume only when that volume is empty.
# KAYA_POSTGRES_PASSWORD_DIR=./data/secrets

# Optional host directory for PostgreSQL custom-format backups.
# KAYA_POSTGRES_BACKUP_DIR=./postgres-backups

# Optional override for encrypted Secret Vault attachments. The default
# /app/data/secret-vault path is already covered by Kaya's data volume.
# KAYA_VAULT_STORAGE_DIR=/app/data/secret-vault

# Optional deployment-managed PWA Web Push VAPID credentials. These override
# UI-managed keys. Configure all three with valid values or Kaya fails closed.
# Keep VAPID_PRIVATE_KEY in deployment secret storage and never commit a real key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
